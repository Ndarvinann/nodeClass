doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title sales
.container
  table
    thead
      th Produce 
      th produce type
      th Tonnage(KG)
      th Cost (ugx)
      th Date 
      th Update
      th Delete

      tbody
       if products.length
        each item in products
          tr
            td #{item.produceName}
            td #{item.produceType}
            td #{item.tonnage}
            td #{item.cost}
            td #{moment(item.date).format("DD-MM-YYYY")}
            td 
              a(href="/updateProduct/"+ item._id) Update
            td 
               form(action = "/deleteProduct" method = "post") 
                input(type="hidden" name = "id" value = item._id)
                button.btn.btn-danger.btn-block(type="submit") Delete
                

