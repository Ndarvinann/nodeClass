doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/css/style.css')
  title Register Sales Agent
.form-container
  h2 Register Sales Agent
  form#salesAgentForm(action = "/signup" method = "post")
    .form-group
      label(for='firstName') Agent Name:
      input#agentName(type='text' name='firstName' required placeholder='Enter agent name')
      small#agentNameError.error-message
      .form-group
        label(for='lastName') Last Name:
        input#lastName(type='text' name='lastName' required)
    .form-group
      label(for='branch') Branch:
      select#branch(name='branch')
        option(value='') Select branch
        option(value='Maganjo') Maganjo
        option(value='Matugga') Matugga
      small#branchError.error-message
    .form-group
      label(for='contact') Contact:
      input#contact(type='text' name='contact' placeholder='Enter phone number')
      small#contactError.error-message
    .form-group
      label(for='Email') Email:
      input#agentEmail(type='text' name='email' placeholder='Enter your email address')
      small#emailError.error-message
      .form-group
       label(for='password') Password:
      input#password(type='password' name='password' required)
    .form-group
    label(for='role') Role:
    select#role(name='role' required)
      option(value='sales') Sales Agent
      option(value='director') Director
    button(type='submit') Register
  a(href='/login')  Log out instead?
script(src='signup.js')
